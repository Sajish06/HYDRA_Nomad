# Application settings
APP_NAME=Meetily Clean Room
APP_ENV=development
DEBUG=true
API_HOST=127.0.0.1
API_PORT=8000

# Meetily Pro Automation API (local gateway on loopback)
MEETILY_BASE_URL=http://127.0.0.1:8420
MEETILY_API_TOKEN=
MEETILY_TIMEOUT_SECONDS=15

# Storage settings
DATABASE_URL=sqlite:///./data/meetily.db
DATA_DIR=./data

# Webhook configuration
WEBHOOK_SECRET=
WEBHOOK_PUBLIC_URL=
WEBHOOK_SIGNATURE_HEADER=
WEBHOOK_SIGNATURE_ALGORITHM=sha256
WEBHOOK_SIGNATURE_PREFIX=
# Unsigned webhooks accepted ONLY when APP_ENV=development AND WEBHOOK_ALLOW_UNSIGNED=true
WEBHOOK_ALLOW_UNSIGNED=false

# AI & Privacy settings
ENABLE_AI=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ENABLE_WEBHOOKS=true

# Privacy guardrails: fail closed, avoid unneeded raw exposure
ENABLE_RAW_STORAGE=false
EXPOSE_RAW_TRANSCRIPTS=false
PERSIST_TOKEN_MAP=false

# Paths
AUDIENCE_PROFILES_PATH=./configs/audience_profiles.yaml
DEAL_CONFIG_PATH=./configs/deal.yaml
DOCUMENTS_DIR=./data/demo/documents
